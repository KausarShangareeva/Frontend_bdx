# Backend base URL for the BDX Safety report service.
# Copy this file to ".env" and set the value, then restart `npm run dev`.
#
# Same machine (default if unset):
#   VITE_API_URL=http://localhost:8000
# Over the network (use the backend dev's IP on the same Wi-Fi):
#   VITE_API_URL=http://192.168.1.42:8000

VITE_API_URL=http://localhost:8000
